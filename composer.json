{
    "name": "leantime/api-data",
    "description": "An API for exposing data to external applications",
    "license": "MIT",
    "type": "leantime-plugin",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Troels Ugilt Jensen",
            "email": "tu@aarhus.dk"
        }
    ],
    "homepage": "https://github.com/ITK-Leantime/leantime-data-api",
    "require-dev": {
        "ergebnis/composer-normalize": "^2.42",
        "illuminate/database": "11.45.1",
        "nesbot/carbon": "3.10.1",
        "phpcsstandards/phpcsextra": "^1.2",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.9",
        "symfony/http-foundation": "7.4.13",
        "zebra-north/phpcs-short-types": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Leantime\\Plugins\\APIData\\": "",
            "Leantime\\Plugins\\APIData\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Stub/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "code-analysis": [
            "@code-analysis/phpstan"
        ],
        "code-analysis/phpstan": [
            "phpstan analyse"
        ],
        "coding-standards-apply": [
            "@coding-standards-apply/phpcbf"
        ],
        "coding-standards-apply/phpcbf": [
            "phpcbf ."
        ],
        "coding-standards-check": [
            "@coding-standards-check/phpcs"
        ],
        "coding-standards-check/phpcs": [
            "phpcs ."
        ],
        "test": "phpunit"
    }
}
